PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
JOURNAL_ACCESS_KEY=your-private-shared-journal-key
BIRDEYE_API_KEY=your-server-only-birdeye-api-key
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:notifications@your-domain.example
# Optional legacy AI credentials; used as fallback when feature-specific keys are unset.
AI_API_KEY=your-server-only-ai-api-key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Set separate credentials in Render Environment for the chat and report features.
AI_CHAT_API_KEY=your-server-only-chat-api-key
AI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
AI_CHAT_MODEL=gpt-4o-mini
AI_REPORT_API_KEY=your-server-only-report-api-key
AI_REPORT_API_URL=https://api.openai.com/v1/chat/completions
AI_REPORT_MODEL=gpt-4o-mini
HELIUS_API_KEY=your-server-only-helius-api-key
